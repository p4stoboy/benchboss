{
  "name": "benchboss",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": ["packages/*", "games", "games/*"],
  "scripts": {
    "gen": "bun run --filter @benchboss/mcp build",
    "build": "bun run gen",
    "pretest": "bun run gen",
    "test": "bun test",
    "typecheck": "bun scripts/typecheck.ts",
    "check": "bun run gen && bun run boundaries && biome check . && bun run typecheck",
    "boundaries": "bun scripts/boundaries.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "oxc-parser": "^0.149.0",
    "rolldown": "^1.2.8",
    "rolldown-plugin-dts": "^0.28.5",
    "typescript": "^7.0.2"
  }
}
